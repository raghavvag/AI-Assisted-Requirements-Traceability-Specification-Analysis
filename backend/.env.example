# =====================================================
# Backend Environment Variables Template
# =====================================================
# Copy this to backend/.env and fill in your values.
# backend/.env is git-ignored — never commit real secrets.

# --- App ---
APP_ENV=development
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-min-32-chars-use-secrets-token-urlsafe
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth 2.0 ---
# Get from: https://console.cloud.google.com/apis/credentials
# This MUST be the same value as frontend/.env.local's VITE_GOOGLE_CLIENT_ID.
# In the Google Cloud Console for this OAuth client, add BOTH of these as
# "Authorised JavaScript origins":  http://localhost:5173  and  http://127.0.0.1:5173
GOOGLE_CLIENT_ID=738447412270-m2f62pke3drtns5852l8fipeju408iqt.apps.googleusercontent.com

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./traceability.db

# --- Qdrant --- (must match docker-compose.yml HTTP port 6338)
QDRANT_URL=http://localhost:6338
QDRANT_COLLECTION=requirements_traceability

# --- LLM Provider ---
# OpenAI is primary. Groq is an optional fallback (used only if OPENAI_API_KEY is blank).
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- SRS diagrams (UML / flowcharts / architecture figures inside the SRS)
#   off     ignore figures
#   local   alt text + OCR (needs the Tesseract binary; TESSERACT_CMD if not on PATH)
#   vision  read figures with a vision model (uses OPENAI_API_KEY), local fallback
# Vision readings are cached per image in SRS_DIAGRAM_CACHE_DIR
# (default ~/.cache/traceability/diagrams) so re-parsing is deterministic.
SRS_DIAGRAM_MODE=local
SRS_VISION_MODEL=gpt-4o-mini
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Embedding Model ---
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- GitHub App (PR review bot, Milestone 3) ---
# Register at GitHub -> Settings -> Developer settings -> GitHub Apps (see manual.md section D).
GITHUB_APP_ID=
# Keep the downloaded .pem OUTSIDE the repo. Either give its path ...
# Use forward slashes or no quotes: inside double quotes \t, \n ... are escapes, so
# "C:\Users\me\Downloads\traceability-bot.pem" silently becomes "...Downloads<TAB>raceability-bot.pem".
GITHUB_APP_PRIVATE_KEY_PATH=C:\keys\traceability-bot.pem
# ... or paste the PEM itself (use \n for line breaks). Leave blank when using the path.
GITHUB_APP_PRIVATE_KEY=
# The "Webhook secret" you typed when registering the app.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=traceability-bot
GITHUB_CHECK_NAME=Requirements Traceability
