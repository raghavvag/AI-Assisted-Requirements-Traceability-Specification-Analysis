# =============================================================================
# AI-Assisted Requirements Traceability Engine — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (see .gitignore).

# -----------------------------------------------------------------------------
# LLM Provider
# OpenAI is the PRIMARY provider. Groq is an optional fallback used only when
# OPENAI_API_KEY is not set. If neither is set, the explainer returns a
# structured template response (no crash).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional fallback — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# SRS diagrams (UML / flowcharts / architecture figures inside the SRS)
#   off     ignore figures
#   local   alt text + OCR (needs the Tesseract binary; TESSERACT_CMD if not on PATH)
#   vision  read figures with a vision model (uses OPENAI_API_KEY), local fallback
# Vision readings are cached per image in SRS_DIAGRAM_CACHE_DIR
# (default ~/.cache/traceability/diagrams) so re-parsing is deterministic.
# -----------------------------------------------------------------------------
SRS_DIAGRAM_MODE=local
SRS_VISION_MODEL=gpt-4o-mini
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# -----------------------------------------------------------------------------
# Embedding Model
# Options: all-mpnet-base-v2 (best quality) | all-MiniLM-L6-v2 (fastest)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-mpnet-base-v2

# -----------------------------------------------------------------------------
# Vector Database (Qdrant) — must match docker-compose.yml (HTTP port 6338)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6338
QDRANT_COLLECTION=traceability_vectors

# -----------------------------------------------------------------------------
# Compliance Thresholds
# -----------------------------------------------------------------------------
# Minimum cosine similarity to classify an endpoint as Compliant (>=)
SIMILARITY_THRESHOLD=0.70

# Delta below which a version change is classified as Drift (<=)
DRIFT_THRESHOLD=-0.10

# Heatmap colour thresholds
THRESHOLD_GREEN=0.75
THRESHOLD_AMBER=0.50
